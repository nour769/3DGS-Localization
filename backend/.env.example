FLASK_DEBUG=1
DATABASE_URL=sqlite:///localizations.db
UPLOAD_DIR=./instance/uploads
SCENES_DIR=./data/scenes
# Local data root, outside the source repository. Paths below are derived from it.
DATA_ROOT=..\..\data
# Legacy alias for users who already named this root PROJECT_DATA_ROOT.
# PROJECT_DATA_ROOT=C:\path\to\MyDrive
# This derives:
#   kitprojet/3DGS/sparse/0/{cameras,images,points3D}.bin
#   kitprojet/3DGS/data/ (447 reference images)
#   kitprojet/data/query.jpg
#   scene-routiere-finale (2).ply
# Optional absolute overrides for data stored outside a scene folder:
# COLMAP_MODEL_PATH=C:\datasets\road\sparse\0
# GAUSSIAN_PLY_PATH=C:\datasets\road\scene-routiere-finale (2).ply
# REFERENCE_IMAGES_DIR=C:\datasets\road\images
# QUERY_IMAGE_PATH=C:\datasets\road\query.jpg
# QUERY_CALIB_PATH=C:\datasets\road\calib.txt
GAUSSIAN_PLY_PATH=
COLMAP_MODEL_PATH=
REFERENCE_IMAGES_DIR=
QUERY_IMAGE_PATH=

# A scene folder contains sparse/0 (COLMAP) and optionally a Gaussian PLY.
# Set REFERENCE_IMAGES_DIR only when images are stored outside the scene folder.
# REFERENCE_IMAGES_DIR=
QUERY_FX=716.614
QUERY_FY=716.614
QUERY_CX=621
QUERY_CY=187.5
QUERY_WIDTH=1242
QUERY_HEIGHT=375
IMAGE_WORK_WIDTH=960
MIN_PNP_INLIERS=15
PNP_REPROJECTION_ERROR=4.0
ENABLE_DINOV2=0
DINO_MODEL=dinov2_vits14
SCENE_FRAME_VERIFIED=0

# Optional OpenAI-compatible API (leave blank for deterministic missing-key fallback).
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
